# SIA Markets — https://markets.suainteligenc.ia.br/
# A pasta deste site fica dentro do public_html do site principal, então ela também
# responderia em suainteligenc.ia.br/markets.suainteligenc.ia.br/. Tudo vai para o subdomínio, em HTTPS.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validação do certificado (AutoSSL) precisa continuar acessível por HTTP.
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # Acesso pelo caminho dentro do site principal: manda para o subdomínio.
  RewriteCond %{HTTP_HOST} !^markets\.suainteligenc\.ia\.br$ [NC]
  RewriteRule ^ https://markets.suainteligenc.ia.br/ [R=301,L]

  # Força HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://markets.suainteligenc.ia.br%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML sempre revalidado, para uma publicação nova aparecer na hora.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Arquivos com hash no nome (pasta assets/): cache de 1 ano.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Fontes, imagens e marca não têm hash: 30 dias.
  <If "%{REQUEST_URI} =~ m#^/(fonts|images|brand)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
